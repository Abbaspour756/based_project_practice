   "source": [
    "def is_happy(n):\n",
    "    seen_numberss = set()\n",
    "    while (n != 1) and (n not in seen_numberss):\n",
    "        seen_numberss.add(n)\n",
    "        n = sum([int(i) ** 2 for i in str(n)])\n",
    "    return n == 1"
   ]
  },
